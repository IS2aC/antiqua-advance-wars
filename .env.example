# Copier en .env (jamais commité) et changer le mot de passe en production.
POSTGRES_PASSWORD=change-moi
# Laisser à true : compose.local.yml le passe à false en local.
COOKIE_SECURE=true
WEB_PORT=8080
# Pour `pnpm dev:server` hors Docker (base lancée avec compose.local.yml, voir docker-compose.yml).
DATABASE_URL=postgres://alkebulan:change-moi@localhost:5432/alkebulan
